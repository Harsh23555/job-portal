MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/
PORT=8000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
SECRET_KEY=your_jwt_secret_key_here
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/user/auth/github/callback

# ─── Adzuna External Job API ───────────────────────────────────────────────────
# Register at: https://developer.adzuna.com/signup
# Official Limits: 25 hits/min, 250 hits/day, 1000 hits/week, 2500 hits/month
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here
ADZUNA_COUNTRY=in
ADZUNA_RESULTS_PER_PAGE=20
# Sync interval in ms (default: 6 hours = 21600000)
EXTERNAL_JOB_SYNC_INTERVAL_MS=21600000
# Keywords to sync (comma-separated)
ADZUNA_SYNC_KEYWORDS=developer,engineer,designer,data analyst,product manager

# ─── Jooble India External Job API ─────────────────────────────────────────────
# Register at: https://in.jooble.org/api/about
# Free plan allows 500 requests per key
JOOBLE_API_KEY=your_jooble_api_key_here
JOOBLE_BASE_URL=https://in.jooble.org/api

# ─── Groq AI Resume Analyzer ───────────────────────────────────────────────────
# Register at: https://console.groq.com/keys
# Supported model supporting Structured Outputs: openai/gpt-oss-120b or llama-3.3-70b-versatile
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# ─── Embeddings (RAG / Semantic Search) ────────────────────────────────────────
# Provider for vector embeddings: local (default) | openai
# local: uses @xenova/transformers + Xenova/all-MiniLM-L6-v2 (~25MB, CPU, no key)
# openai: uses text-embedding-ada-002 (requires OPENAI_API_KEY)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=20
# Only required if EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=

# ─── RAG / LLM Answer Generation ───────────────────────────────────────────────
# Provider for AI answer generation in /ai-search: groq | none
RAG_LLM_PROVIDER=groq
# GROQ_API_KEY already declared above — will be reused
RAG_LLM_MODEL=llama-3.3-70b-versatile

# ─── Remotive Public API ────────────────────────────────────────────────────────
# No API key required. Set to false to disable.
REMOTIVE_ENABLED=true

# ─── LinkedIn (Always Unavailable) ─────────────────────────────────────────────
# LinkedIn does not offer a public job-search API for third-party aggregators.
# This value is informational only — no key is accepted.
LINKEDIN_STATUS=unavailable

# ─── Admin Authentication ──────────────────────────────────────────────────────
# Admin login for the HR verification dashboard.
# Generate a password hash with: node -e "require('bcryptjs').hash('YourStrongPassword', 10).then(h => console.log(h))"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=$2b$10$your_bcrypt_hash_here
