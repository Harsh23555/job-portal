{
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "utils/**",
          "models/**",
          "controllers/**",
          "middlewares/**",
          "routes/**",
          "services/**",
          "providers/**",
          "storage/**"
        ],
        "maxDuration": 30
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "index.js"
    }
  ]
}
